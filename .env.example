# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/peniel_admission

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
# Optional HMAC key for email-based reset throttling; defaults to JWT_SECRET.
RESET_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Private Supabase Storage bucket for passport photographs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=applicant-documents

# Resend application confirmation email
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Peniel Admissions <admissions@example.com>
